# Copy this file to .env and fill in your real Discord bot token.
# Get one at https://discord.com/developers/applications
DISCORD_TOKEN=your-discord-bot-token-here

# Optional: local port for the /lyrics activity server (default 8765)
# LYRICS_PORT=8765

# Optional: /lol and /valo (see README step 6)
# RIOT_API_KEY=your-riot-api-key
# HENRIK_API_KEY=your-henrikdev-api-key
# LOL_SSH_HOST=pc
# LOL_INSTALL_DIR=D:\Riot Games\League of Legends
# VALO_SHARD=ap                 # /valo-live 用的 Riot 伺服器分區(台灣是 ap)，借 PC 上 Riot Client 的登入查對局
